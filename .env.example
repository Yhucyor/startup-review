# ==============================================================================
# SYNCHRO.VN - Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual credentials.
# Do NOT commit .env with real secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. AI MODEL GATEWAY (Specs 03, 04)
# ------------------------------------------------------------------------------
# OpenAI API configuration (Live provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Google Gemini API configuration (Optional alternative provider)
GEMINI_API_KEY=your_gemini_api_key_here

# Default tenant execution mode: live | demo
DEFAULT_AI_MODE=demo

# Maximum timeout in milliseconds per model step (default: 30000ms)
MODEL_CALL_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# 3. DATABASE & PERSISTENCE (Spec 01 - PostgreSQL Multi-Tenant)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/synchro_db?schema=public

# ------------------------------------------------------------------------------
# 4. REDIS & ASYNC QUEUE (Spec 02 - BullMQ Outbox & Workflow Event Bus)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 5. SECURITY & ENCRYPTION
# ------------------------------------------------------------------------------
# Secret key used for signing JWT authentication tokens (minimum 32 characters)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars

# Symmetric key used for encrypting marketplace API tokens at rest (32-byte hex)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 6. MARKETPLACE CONNECTIONS (Spec 11 - Shopee Open Platform Adapter)
# ------------------------------------------------------------------------------
# Shopee Open Platform App credentials
SHOPEE_PARTNER_ID=your_shopee_partner_id
SHOPEE_PARTNER_KEY=your_shopee_partner_key
# Shopee API Base URL:
# Production: https://partner.shopeemobile.com/api/v2
# Test/Sandbox: https://partner.test-stable.shopeemobile.com/api/v2
SHOPEE_API_URL=https://partner.test-stable.shopeemobile.com/api/v2
SHOPEE_REDIRECT_URL=http://localhost:3000/api/integrations/shopee/callback

# TikTok Shop Open Platform (Future expansion)
TIKTOK_SHOP_APP_KEY=your_tiktok_app_key
TIKTOK_SHOP_APP_SECRET=your_tiktok_app_secret

# Lazada Open Platform (Future expansion)
LAZADA_APP_KEY=your_lazada_app_key
LAZADA_APP_SECRET=your_lazada_app_secret

# ------------------------------------------------------------------------------
# 7. OBJECT STORAGE & MEDIA CDN (Spec 20 - Product Images)
# ------------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_BUCKET_NAME=synchro-product-media
S3_ACCESS_KEY_ID=minio_admin
S3_SECRET_ACCESS_KEY=minio_password
